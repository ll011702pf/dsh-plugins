{
  "name": "@local/dsh-market-analysis",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A market-analysis workbench in the Harness Web sidebar: market size and CAGR, weighted segment breakdown, CR/HHI competitive concentration, trends, and a Markdown report you can copy or export.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
